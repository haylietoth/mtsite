
<div id="wordmark-container" class="fixed inset-0 pointer-events-none z-[70]">
  <% if (id == 'index') { %>
    <a href="/">
      <span id="letter-m" class="absolute font-light text-white uppercase transition-colors duration-100 flex items-baseline justify-start">M.</span>
      <span id="letter-g" class="absolute font-light text-white uppercase transition-colors duration-100 flex items-baseline justify-center">G.</span>
      <span id="letter-e" class="absolute font-light text-white uppercase transition-colors duration-100 flex items-baseline justify-end">E.<span>
    </a>
  <% } else { %>
      <span id="wm-m" class="wm-letter">M.</span>
      <span id="wm-g" class="wm-letter">G.</span>
      <span id="wm-e" class="wm-letter">E.</span>
  <% } %>
</div>