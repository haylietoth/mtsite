  <% } else { %>
    <div id="wordmark-container" class="fixed z-[70]">
      <a href="/" class="hover:opacity-50">
        <span class="wm-letter"><span>M.</span><span>G.</span><span>E.</span>
        </span>
      </a>
    </div>
  <% } %>
